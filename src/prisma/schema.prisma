generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String        @id @default(cuid())
  name           String
  email          String        @unique
  emailVerified  Boolean?      @default(false)
  image          String?
  passwordHash   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Custom merchant fields
  allowedDomains String[]
  planTier       PlanTier      @default(FREE)
  role           String        @default("MERCHANT")

  // Stripe Billing fields
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  stripePriceId        String?
  subscriptionStatus   String?

  // Quota & Email Alert Tracking
  rolloverCredits              Int       @default(0)
  extraCredits                 Int       @default(0)
  lastQuotaWarningEmailSentAt  DateTime?
  lastQuotaExceededEmailSentAt DateTime?

  // Custom relations
  apiKeys         ApiKey[]
  products        Product[]
  conversations   Conversation[]
  visitors        Visitor[]
  widgetConfig    WidgetConfig?
  knowledgeChunks KnowledgeChunk[]

  // Better Auth relations
  sessions      Session[]
  accounts      Account[]

  @@map("Merchant")
}

enum PlanTier {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

model ApiKey {
  id             String    @id @default(cuid())
  merchantId     String
  merchant       User      @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  keyPrefix      String
  hashedKey      String    @unique
  isActive       Boolean   @default(true)
  name           String    @default("My Chatbot")
  template       String    @default("Customer Support")
  systemPrompt   String    @default("")
  allowedDomains String[]
  lastUsedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@index([merchantId])
}

model Product {
  id          String    @id @default(cuid())
  merchantId  String
  merchant    User      @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  externalId  String
  title       String
  description String?
  price       Decimal   @db.Decimal(10, 2)
  currency    String    @default("USD")
  imageUrl    String?
  productUrl  String
  category    String?
  inStock     Boolean   @default(true)
  embedding   Unsupported("vector(1536)")?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([merchantId, externalId])
  @@index([merchantId])
}

model WidgetConfig {
  id               String   @id @default(cuid())
  merchantId       String   @unique
  merchant         User     @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  primaryColor     String   @default("#111111")
  greetingMessage  String   @default("Hi! How can I help you shop today?")
  botName          String   @default("Shop Assistant")
  position         String   @default("bottom-right")
  addToCartEnabled Boolean  @default(true)
}

model Conversation {
  id         String    @id @default(cuid())
  merchantId String
  merchant   User      @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  sessionId  String
  messages   Message[]
  createdAt  DateTime  @default(now())

  @@index([merchantId, sessionId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  toolCalls      Json?
  tokensUsed     Int?         @default(0)
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model Visitor {
  id          String   @id @default(cuid())
  merchantId  String
  merchant    User     @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  visitorId   String
  ipAddress   String?
  country     String   @default("Unknown")
  countryCode String   @default("UN")
  city        String?
  pageViews   Int      @default(1)
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  @@unique([merchantId, visitorId])
  @@index([merchantId])
}

model KnowledgeChunk {
  id          String    @id @default(cuid())
  merchantId  String
  merchant    User      @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  url         String
  content     String
  embedding   Unsupported("vector(1536)")?
  createdAt   DateTime  @default(now())

  @@index([merchantId])
}
